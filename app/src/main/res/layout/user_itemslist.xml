<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:backgroundTint="#785696"
    android:elevation="10dp"
    android:layout_marginHorizontal="50dp"
    android:layout_marginTop="25dp"
    app:cardCornerRadius="6dp"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="5dp"
        >

         <androidx.constraintlayout.widget.ConstraintLayout
             android:id="@+id/food_lay"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             app:layout_constraintStart_toStartOf="parent"
             app:layout_constraintTop_toTopOf="parent"
             android:orientation="horizontal"
             >


             <TextView
                 android:id="@+id/t_food"
                 android:layout_width="fill_parent"
                 android:layout_height="wrap_content"
                 android:text="Food frd"
                 android:textSize="12sp"
                 android:textColor="@color/white"
                 android:textStyle="bold"
                 android:layout_marginLeft="50dp"
                 app:layout_constraintStart_toStartOf="parent"
                 app:layout_constraintTop_toTopOf="parent"
                 />

             <TextView
                 android:layout_width="fill_parent"
                 android:layout_height="wrap_content"
                 android:text="2600"
                 android:textSize="12sp"
                 android:textColor="@color/white"
                 android:textStyle="bold"
                 android:layout_marginLeft="220dp"
                 app:layout_constraintStart_toEndOf="@id/t_food"
                 app:layout_constraintTop_toTopOf="parent"

                 />

         </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/medi_lay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/food_lay"
            android:orientation="horizontal"
            >


            <TextView
                android:id="@+id/t_medi"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="Medical"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:paddingLeft="50dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />

            <TextView
                android:id="@+id/et_medi"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="2700"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_marginLeft="220dp"
                app:layout_constraintStart_toEndOf="@id/t_medi"
                app:layout_constraintTop_toTopOf="parent"

                />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/travel_lay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/medi_lay"
            android:orientation="horizontal"
            >


            <TextView
                android:id="@+id/t_travel"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="Travel"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:paddingLeft="50dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />

            <TextView
                android:id="@+id/et_travel"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="3000"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_marginLeft="220dp"
                app:layout_constraintStart_toEndOf="@id/t_travel"
                app:layout_constraintTop_toTopOf="parent"

                />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/transport_lay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/travel_lay"
            android:orientation="horizontal"
            >


            <TextView
                android:id="@+id/t_transport"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="50dp"
                android:text="transport"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/et_transport"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="14000"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_marginLeft="220dp"
                app:layout_constraintStart_toEndOf="@id/t_transport"
                app:layout_constraintTop_toTopOf="parent"

                />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bill_lay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/transport_lay"
            android:orientation="horizontal"
            >


            <TextView
                android:id="@+id/t_bill"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="Mobile Bill"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:paddingLeft="50dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />

            <TextView
                android:id="@+id/et_bill"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="200"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_marginLeft="220dp"
                app:layout_constraintStart_toEndOf="@id/t_bill"
                app:layout_constraintTop_toTopOf="parent"

                />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clo_lay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/bill_lay"
            android:orientation="horizontal"
            >


            <TextView
                android:id="@+id/t_clo"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="Clothers"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:paddingLeft="50dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />

            <TextView
                android:id="@+id/et_clo"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="200"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_marginLeft="220dp"
                app:layout_constraintStart_toEndOf="@id/t_clo"
                app:layout_constraintTop_toTopOf="parent"

                />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/others_lay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/clo_lay"
            android:orientation="horizontal"
            >


            <TextView
                android:id="@+id/t_others"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="Others"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:paddingLeft="50dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />

            <TextView
                android:id="@+id/et_others"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="1900"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_marginLeft="220dp"
                app:layout_constraintStart_toEndOf="@id/t_others"
                app:layout_constraintTop_toTopOf="parent"

                />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>